---
/**
 * Titre animé mot par mot. Les segments entre *astérisques*
 * sont affichés en italique serif.
 */
interface Props { text: string; as?: 'h1' | 'h2' | 'h3' | 'p'; class?: string; delay?: number }
const { text, as: Tag = 'h2', class: cls = '', delay = 0 } = Astro.props;
const parts = text.split(/(\*[^*]+\*)/g).filter(Boolean);
let i = 0;
const words: { w: string; em: boolean; i: number }[] = [];
for (const part of parts) {
  const em = part.startsWith('*');
  for (const w of part.replace(/\*/g, '').split(/\s+/).filter(Boolean)) words.push({ w, em, i: i++ });
}
---
<Tag class:list={['split', cls]} data-reveal-split style={`--d:${delay}s`} aria-label={text.replace(/\*/g, '')}>
  {words.map(({ w, em, i }) => (
    <><span class="w" aria-hidden="true"><span class:list={{ serif: em }} style={`--i:${i}`}>{w}</span></span>{' '}</>
  ))}
</Tag>
