---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Services from '../components/sections/Services.astro';
import CallToAction from '../components/sections/CallToAction.astro';
---
<BaseLayout title="Services — création, rénovation et visibilité" description="Création de sites Internet sur mesure, rénovation de sites existants et développement de la visibilité en ligne pour artisans et commerçants.">
  <PageHero
    eyebrow="Services"
    title="Trois expertises, *une seule ambition.*"
    intro="Que vous partiez de zéro ou que votre site ait besoin d’un second souffle, nous construisons un outil fiable, élégant et pensé pour vos clients."
  />
  <Services show={false} />
  <div style="height:clamp(56px,8vw,110px)"></div>
  <CallToAction />
</BaseLayout>
