---
/** Illustrations vectorielles par secteur, utilisées dans les maquettes. */
import type { Illustration } from '../../data/projects';
interface Props { name: Illustration }
const { name } = Astro.props;
---
<svg class="ill" viewBox="0 0 200 200" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <radialGradient id={`glow-${name}`} cx="70%" cy="20%" r="80%">
      <stop offset="0" stop-color="#fff" stop-opacity=".45" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </radialGradient>
  </defs>
  <rect width="200" height="200" fill={`url(#glow-${name})`} />
  <g fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round">
    {name === 'house' && (
      <>
        <path d="M0 168h200" stroke-opacity=".35" stroke-width="1.5" />
        <path d="M44 168V98l56-40 56 40v70" stroke-width="3" stroke-opacity=".9" />
        <path d="M30 108 100 56l70 52" stroke-width="3" />
        <rect x="84" y="122" width="32" height="46" rx="2" stroke-width="2.5" />
        <rect x="58" y="108" width="18" height="18" rx="1.5" stroke-width="2" stroke-opacity=".8" />
        <rect x="124" y="108" width="18" height="18" rx="1.5" stroke-width="2" stroke-opacity=".8" />
        <path d="M136 68V48h12v29" stroke-width="2.5" stroke-opacity=".7" />
        <path d="M150 168l14-50 8 4-12 46" stroke-width="2" stroke-opacity=".5" />
      </>
    )}
    {name === 'car' && (
      <>
        <path d="M0 150h200" stroke-opacity=".3" stroke-width="1.5" />
        <path d="M22 132c0-10 6-16 16-18l22-4 22-22c4-4 9-6 15-6h34c6 0 11 2 15 7l18 21 16 3c9 2 16 9 16 18v8H22z" stroke-width="3" />
        <path d="M68 108l18-18h22v18zM116 108V90h18l14 18z" stroke-width="2" stroke-opacity=".75" />
        <circle cx="62" cy="142" r="14" stroke-width="3" fill="rgba(0,0,0,.35)" />
        <circle cx="150" cy="142" r="14" stroke-width="3" fill="rgba(0,0,0,.35)" />
        <circle cx="62" cy="142" r="4" fill="#fff" stroke="none" />
        <circle cx="150" cy="142" r="4" fill="#fff" stroke="none" />
        <path d="M30 40h40M20 52h30M150 36h34" stroke-width="2" stroke-opacity=".35" />
      </>
    )}
    {name === 'plate' && (
      <>
        <circle cx="100" cy="112" r="58" stroke-width="2.5" stroke-opacity=".9" />
        <circle cx="100" cy="112" r="40" stroke-width="1.5" stroke-opacity=".5" />
        <path d="M86 108c4-12 24-14 30-2 4 9-6 18-16 16-8-1-16-6-14-14z" fill="rgba(255,255,255,.25)" stroke-width="2" />
        <path d="M24 66v34c0 6 4 10 8 10v46M32 66v28M40 66v34c0 6-4 10-8 10" stroke-width="2.5" />
        <path d="M168 66c-8 0-12 14-12 28 0 8 4 12 10 12v50" stroke-width="2.5" />
        <path d="M74 36c4-8-4-12 0-20M100 34c4-8-4-12 0-20M126 36c4-8-4-12 0-20" stroke-width="2" stroke-opacity=".55" />
      </>
    )}
    {name === 'leaf' && (
      <>
        <path d="M0 172c40-14 80-14 120-4s60 8 80 0" stroke-width="2" stroke-opacity=".5" />
        <path d="M100 168V80" stroke-width="3" />
        <path d="M100 120c-30 0-46-20-46-46 26 0 46 16 46 46zM100 100c26 0 44-18 44-44-26 0-44 16-44 44z" stroke-width="3" fill="rgba(255,255,255,.15)" />
        <path d="M100 120 70 90M100 100l28-28" stroke-width="1.5" stroke-opacity=".7" />
        <path d="M30 168v-40c0-12 8-20 16-20s16 8 16 20v40M46 168v-34" stroke-width="2" stroke-opacity=".55" />
        <path d="M150 168v-24c0-8 6-14 12-14s12 6 12 14v24" stroke-width="2" stroke-opacity=".55" />
        <circle cx="160" cy="40" r="12" stroke-width="2" stroke-opacity=".6" />
      </>
    )}
    {name === 'sparkle' && (
      <>
        <rect x="40" y="40" width="120" height="120" rx="6" stroke-width="2.5" stroke-opacity=".8" />
        <path d="M100 40v120M40 100h120" stroke-width="1.5" stroke-opacity=".5" />
        <path d="M60 140l60-60" stroke-width="10" stroke-opacity=".25" />
        <path d="M128 52l5 13 13 5-13 5-5 13-5-13-13-5 13-5z" fill="#fff" stroke-width="1" />
        <path d="M70 112l3 7 7 3-7 3-3 7-3-7-7-3 7-3z" fill="#fff" stroke-width="1" />
        <path d="M150 128l2.5 6 6 2.5-6 2.5-2.5 6-2.5-6-6-2.5 6-2.5z" fill="#fff" stroke-width="1" fill-opacity=".8" />
      </>
    )}
    {name === 'scissors' && (
      <>
        <circle cx="70" cy="140" r="18" stroke-width="3" />
        <circle cx="130" cy="140" r="18" stroke-width="3" />
        <path d="M82 126 140 40M118 126 60 40" stroke-width="3.5" />
        <circle cx="100" cy="98" r="3" fill="#fff" stroke="none" />
        <path d="M24 60c10-20 30-24 40-10M150 30c18 0 30 14 26 32" stroke-width="2" stroke-opacity=".45" />
      </>
    )}
  </g>
</svg>
<style>
  .ill { position: absolute; inset: 0; width: 100%; height: 100%; }
</style>
