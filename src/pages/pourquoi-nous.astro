---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Why from '../components/sections/Why.astro';
import CallToAction from '../components/sections/CallToAction.astro';
---
<BaseLayout title="Pourquoi travailler avec nous" description="Un interlocuteur disponible, un site adapté à chaque activité, une expérience optimale sur téléphone et un accompagnement personnalisé.">
  <PageHero
    eyebrow="Pourquoi nous"
    title="Votre site est souvent *le premier contact* avec un futur client."
    intro="Donnez-lui une bonne raison de vous choisir."
  />
  <Why show={false} />
  <div style="height:clamp(56px,8vw,110px);background:var(--dark)"></div>
  <CallToAction />
</BaseLayout>
