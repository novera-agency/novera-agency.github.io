---
import { sectors } from '../../data/content';
const list = [...sectors, ...sectors];
---
<section class="marquee" aria-label="Secteurs accompagnés">
  <p class="marquee__label">Nous accompagnons</p>
  <div class="marquee__track-wrap">
    <ul role="list" class="marquee__track">
      {list.map((s, i) => <li aria-hidden={i >= sectors.length ? 'true' : undefined}>{s}<span class="marquee__dot"></span></li>)}
    </ul>
  </div>
</section>
<style>
  .marquee { display: flex; align-items: center; gap: 32px; padding: 34px 0; border-block: 1px solid var(--line); overflow: hidden; }
  .marquee__label { flex: none; padding-left: var(--gutter); font-size: .78rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .marquee__track-wrap { overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); flex: 1; }
  .marquee__track { display: flex; width: max-content; animation: marquee 45s linear infinite; }
  .marquee:hover .marquee__track { animation-play-state: paused; }
  .marquee__track li { display: flex; align-items: center; gap: 40px; padding-right: 40px; font-size: clamp(1.3rem, 2.4vw, 2rem); font-weight: 600; letter-spacing: -0.03em; white-space: nowrap; }
  .marquee__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @media (max-width: 700px) { .marquee__label { display: none; } .marquee__track-wrap { mask-image: none; } }
</style>
