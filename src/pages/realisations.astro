---
import { u } from '../utils/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import DevicePair from '../components/mockups/DevicePair.astro';
import CallToAction from '../components/sections/CallToAction.astro';
import Icon from '../components/Icon.astro';
import { projects } from '../data/projects';
---
<BaseLayout title="Réalisations — projets de démonstration" description="Découvrez nos projets de démonstration de sites Internet pour artisans, garages, restaurants, paysagistes, entreprises de nettoyage et salons de coiffure.">
  <PageHero
    eyebrow="Réalisations"
    title="Des sites conçus *pour chaque métier.*"
    intro="Chaque secteur a ses codes, ses clients et ses attentes. Ces projets de démonstration montrent comment nous adaptons la structure, le ton et le design à chaque activité."
  >
    <p class="notice" data-reveal style="--d:.4s"><Icon name="alert" size={20} /><span><strong>Projets de démonstration et projets indépendants.</strong> Les projets marqués « démonstration » présentent des entreprises fictives, imaginées pour illustrer notre savoir-faire. Les projets marqués « indépendant » sont des projets réels. Aucun d’eux ne constitue une référence client.</span></p>
    <nav class="jump" aria-label="Accès rapide aux projets" data-reveal style="--d:.5s">
      {projects.map((p) => <a href={`#${p.slug}`}>{p.category}</a>)}
    </nav>
  </PageHero>

  <div class="cases">
    {projects.map((p, i) => (
      <section class:list={['case', { 'case--reverse': i % 2 === 1 }]} id={p.slug} aria-labelledby={`${p.slug}-title`}>
        <div class="container case__inner">
          <div class="case__visual" data-reveal="scale" style={`--tint:${p.theme.dark ? p.theme.bg : p.theme.photoA}`}>
            <DevicePair project={p} />
          </div>
          <div class="case__body">
            <p class="case__meta" data-reveal><span>{String(i + 1).padStart(2, '0')}</span>{p.category}{(p.badge || p.demo) && <em>{p.badge ?? 'Démonstration'}</em>}</p>
            <h2 class="h3 case__title" id={`${p.slug}-title`} data-reveal>{p.name}</h2>
            <p class="case__summary" data-reveal>{p.summary}</p>
            <div class="case__cols" data-reveal>
              <div>
                <h3 class="case__label">Objectifs</h3>
                <ul role="list">{p.goals.map((g) => <li><Icon name="check" size={16} />{g}</li>)}</ul>
              </div>
              <div>
                <h3 class="case__label">Fonctionnalités</h3>
                <ul role="list">{p.features.map((f) => <li><Icon name="check" size={16} />{f}</li>)}</ul>
              </div>
            </div>
            <div class="case__links" data-reveal>
              {p.url && <a href={p.url} class="btn btn--sm" target="_blank" rel="noopener noreferrer">Voir le site en ligne<Icon name="arrow-up-right" class="btn__icon" /></a>}
              <a href={u('/contact/?projet=creation')} class="link-arrow">Un projet similaire ? Parlons-en<Icon name="arrow" /></a>
            </div>
          </div>
        </div>
      </section>
    ))}
  </div>

  <CallToAction />
</BaseLayout>

<style>
  .notice { display: flex; gap: 14px; align-items: flex-start; padding: 18px 22px; border-radius: 16px; background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); max-width: 820px; font-size: .95rem; color: var(--ink-2); }
  .notice :global(svg) { flex: none; color: var(--accent); margin-top: 1px; }
  .jump { display: flex; flex-wrap: wrap; gap: 8px; }
  .jump a { padding: 9px 16px; border-radius: 999px; font-size: .9rem; font-weight: 500; box-shadow: inset 0 0 0 1px var(--line-strong); transition: background-color .3s, color .3s; }
  .jump a:hover { background: var(--ink); color: var(--bg); }
  .cases { padding-bottom: var(--section); }
  .case { padding-block: clamp(48px, 7vw, 100px); border-top: 1px solid var(--line); }
  .case__inner { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); align-items: center; }
  .case--reverse .case__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); }
  .case--reverse .case__visual { order: 2; }
  .case__visual { padding: clamp(28px, 5vw, 60px) clamp(20px, 4vw, 48px) clamp(20px, 3vw, 36px); border-radius: var(--radius-l); background: radial-gradient(80% 80% at 80% 0%, color-mix(in srgb, var(--tint) 45%, transparent), transparent 70%), color-mix(in srgb, var(--tint) 18%, var(--bg-2)); }
  .case__body { display: grid; gap: 22px; justify-items: start; }
  .case__meta { display: flex; align-items: center; gap: 12px; font-size: .9rem; color: var(--muted); font-weight: 500; flex-wrap: wrap; }
  .case__meta span { font-variant-numeric: tabular-nums; color: var(--ink); font-weight: 700; }
  .case__meta em { font-style: normal; padding: 4px 10px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); font-size: .76rem; font-weight: 700; letter-spacing: .04em; }
  .case__title { font-size: clamp(2rem, 3.6vw, 3.2rem); letter-spacing: -0.04em; }
  .case__summary { color: var(--ink-2); font-size: 1.08rem; }
  .case__links { display: flex; align-items: center; gap: 20px 28px; flex-wrap: wrap; }
  .case__cols { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; width: 100%; padding-block: 8px; }
  .case__label { font-size: .78rem; text-transform: uppercase; letter-spacing: .14em; color: var(--muted); font-weight: 600; margin-bottom: 12px; }
  .case__cols ul { display: grid; gap: 8px; }
  .case__cols li { display: flex; gap: 10px; align-items: flex-start; font-size: .96rem; font-weight: 500; }
  .case__cols :global(svg) { flex: none; color: var(--accent); margin-top: 4px; }
  @media (max-width: 900px) {
    .case__inner, .case--reverse .case__inner { grid-template-columns: 1fr; }
    .case--reverse .case__visual { order: 0; }
  }
  @media (max-width: 520px) { .case__cols { grid-template-columns: 1fr; } }
</style>
