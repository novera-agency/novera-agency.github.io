---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
interface Props { title: string; description: string; updated: string }
const { title, description, updated } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <PageHero eyebrow={title} title={title}>
    <p class="muted" data-reveal style="--d:.3s">Dernière mise à jour : {updated}</p>
  </PageHero>
  <div class="container">
    <article class="prose" data-reveal>
      <slot />
    </article>
  </div>
</BaseLayout>
<style>
  .prose { max-width: 820px; padding: clamp(28px, 5vw, 64px); margin-bottom: var(--section); background: var(--surface); border-radius: var(--radius-l); box-shadow: var(--shadow-s); }
  .prose :global(h2) { font-size: clamp(1.35rem, 2vw, 1.7rem); letter-spacing: -0.03em; margin: 2.2em 0 .7em; scroll-margin-top: calc(var(--header-h) + 24px); }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) { font-size: 1.1rem; letter-spacing: -0.02em; margin: 1.6em 0 .5em; }
  .prose :global(p), .prose :global(li) { color: var(--ink-2); }
  .prose :global(p + p) { margin-top: .9em; }
  .prose :global(ul) { padding-left: 1.2em; margin: .8em 0; display: grid; gap: .4em; }
  .prose :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; overflow-wrap: anywhere; }
  .prose :global(strong) { color: var(--ink); }
  .prose :global(.todo) { background: #fff4d6; color: #6b4a00; padding: 1px 6px; border-radius: 6px; font-weight: 600; }
  .prose :global(dl) { display: grid; grid-template-columns: max-content 1fr; gap: 8px 24px; margin-top: .8em; }
  .prose :global(dt) { font-weight: 600; color: var(--ink); }
  .prose :global(dd) { margin: 0; color: var(--ink-2); }
  @media (max-width: 600px) { .prose :global(dl) { grid-template-columns: 1fr; gap: 2px; } .prose :global(dd) { margin-bottom: 10px; } }
</style>
