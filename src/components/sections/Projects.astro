---
import { u } from '../../utils/url';
import { projects, categories } from '../../data/projects';
import SectionHeading from '../SectionHeading.astro';
import ProjectCard from '../ProjectCard.astro';
import Icon from '../Icon.astro';
interface Props { showHeading?: boolean }
const { showHeading = true } = Astro.props;
---
<section class="section" id="realisations" aria-label="Réalisations">
  <div class="container">
    {showHeading && (
      <SectionHeading
        eyebrow="Nos réalisations"
        title="Des sites pensés *pour chaque métier.*"
        intro="Découvrez une sélection de projets pour illustrer notre approche selon les secteurs d’activité."
      />
    )}
    <div class="filters" role="toolbar" aria-label="Filtrer les réalisations par secteur" data-filters>
      {categories.map((c, i) => (
        <button type="button" class:list={['filter', { 'is-active': i === 0 }]} data-filter={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>{c.label}</button>
      ))}
    </div>
    <div class="grid" data-filter-grid>
      {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>
    <div class="projects__foot" data-reveal>
      <p class="projects__disclaimer"><Icon name="alert" size={18} />Les projets marqués « démonstration » présentent des entreprises fictives, et les projets « indépendants » sont des projets réels. Aucun ne constitue une référence client.</p>
      {showHeading && <a href={u('/realisations/')} class="btn btn--ghost">Voir le détail des projets<Icon name="arrow" class="btn__icon" /></a>}
    </div>
  </div>
</section>
<style>
  .filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: clamp(32px, 4vw, 48px); }
  .filter { padding: 10px 18px; border-radius: 999px; font-size: .92rem; font-weight: 500; box-shadow: inset 0 0 0 1px var(--line-strong); color: var(--ink-2); transition: background-color .3s var(--ease), color .3s var(--ease), box-shadow .3s; }
  @media (hover: hover) { .filter:hover { color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink); } }
  .filter.is-active { background: var(--ink); color: var(--bg); box-shadow: none; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(40px, 5vw, 64px) clamp(20px, 3vw, 40px); }
  .projects__foot { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; margin-top: clamp(48px, 6vw, 72px); padding-top: 32px; border-top: 1px solid var(--line); }
  .projects__disclaimer { display: flex; gap: 10px; align-items: flex-start; font-size: .92rem; color: var(--muted); max-width: 70ch; }
  .projects__disclaimer :global(svg) { flex: none; margin-top: 2px; }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; } .filters { flex-wrap: nowrap; overflow-x: auto; margin-inline: calc(-1 * var(--gutter)); padding: 2px var(--gutter); scrollbar-width: none; } .filter { flex: none; } }
</style>
