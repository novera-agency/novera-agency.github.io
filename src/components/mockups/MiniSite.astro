---
/**
 * Rendu d'un site de démonstration en HTML/CSS pur (aucune image),
 * mis à l'échelle via les unités de conteneur (cqw).
 * `layout="desktop"` ou `"mobile"`.
 */
import type { Project } from '../../data/projects';
import Illustration from './Illustration.astro';
interface Props { project: Project; layout?: 'desktop' | 'mobile' }
const { project, layout = 'desktop' } = Astro.props;
const t = project.theme;
const s = project.site;
const style = [
  `--m-bg:${t.bg}`, `--m-surface:${t.surface}`, `--m-ink:${t.ink}`, `--m-muted:${t.muted}`,
  `--m-accent:${t.accent}`, `--m-accent-ink:${t.accentInk}`, `--m-photo-a:${t.photoA}`, `--m-photo-b:${t.photoB}`,
].join(';');
const brand = project.name;
---
<div class:list={['ms', `ms--${layout}`, { 'ms--serif': t.serif, 'ms--dark': t.dark }]} style={style} aria-hidden="true">
  <div class="ms__nav">
    <span class="ms__brand"><i></i>{brand}</span>
    {layout === 'desktop' ? (
      <span class="ms__links">{s.nav.map((n) => <span>{n}</span>)}</span>
    ) : (
      <span class="ms__burger"><i></i><i></i></span>
    )}
    {layout === 'desktop' && <span class="ms__pill">{s.cta}</span>}
  </div>

  <div class="ms__hero">
    <div class="ms__copy">
      <span class="ms__kicker">{s.kicker}</span>
      <span class="ms__title">{s.headline}</span>
      <span class="ms__text">Une équipe locale, des réponses rapides et un travail soigné, du premier contact à la fin du projet.</span>
      <span class="ms__ctas"><span class="ms__btn">{s.cta}</span><span class="ms__btn ms__btn--ghost">Nos services</span></span>
    </div>
    <div class="ms__photo">
      <Illustration name={s.illustration} />
      <span class="ms__badge"><b>✓</b> Devis gratuit</span>
    </div>
  </div>

  <div class="ms__cards">
    {s.cards.map((c, i) => (
      <span class="ms__card">
        <span class="ms__thumb" style={`--k:${i}`}></span>
        <b>{c}</b>
        <span class="ms__line"></span>
        <span class="ms__line ms__line--short"></span>
      </span>
    ))}
  </div>
  {layout === 'mobile' && <span class="ms__call">Appeler</span>}
</div>

<style>
  .ms {
    container-type: inline-size;
    --u: 1cqw;
    position: relative; height: 100%; overflow: hidden;
    background: var(--m-bg); color: var(--m-ink);
    font-family: var(--font-sans);
    display: flex; flex-direction: column;
    user-select: none; pointer-events: none;
  }
  .ms--serif .ms__title, .ms--serif .ms__brand { font-family: var(--font-serif); font-weight: 400; letter-spacing: -0.01em; }
  .ms--serif .ms__title { font-style: italic; }

  .ms__nav { display: flex; align-items: center; gap: calc(var(--u) * 3); padding: calc(var(--u) * 2.4) calc(var(--u) * 4); font-size: calc(var(--u) * 1.35); }
  .ms__brand { display: inline-flex; align-items: center; gap: calc(var(--u) * .8); font-weight: 700; font-size: calc(var(--u) * 1.8); letter-spacing: -0.02em; white-space: nowrap; }
  .ms__brand i { width: calc(var(--u) * 1.9); height: calc(var(--u) * 1.9); border-radius: 30%; background: var(--m-accent); }
  .ms__links { display: flex; gap: calc(var(--u) * 2.6); margin-left: auto; color: var(--m-muted); white-space: nowrap; }
  .ms__pill { padding: calc(var(--u) * .9) calc(var(--u) * 1.8); border-radius: 99px; background: var(--m-ink); color: var(--m-bg); font-weight: 600; white-space: nowrap; }

  .ms__hero { display: grid; grid-template-columns: 1.05fr 1fr; gap: calc(var(--u) * 3.5); padding: calc(var(--u) * 3) calc(var(--u) * 4) calc(var(--u) * 3); align-items: center; flex: 1; }
  .ms__copy { display: flex; flex-direction: column; gap: calc(var(--u) * 1.6); }
  .ms__kicker { font-size: calc(var(--u) * 1.2); text-transform: uppercase; letter-spacing: .14em; color: var(--m-accent); font-weight: 700; }
  .ms__title { font-size: calc(var(--u) * 4.6); line-height: 1.02; font-weight: 700; letter-spacing: -0.04em; }
  .ms__text { font-size: calc(var(--u) * 1.4); color: var(--m-muted); line-height: 1.5; max-width: 36ch; }
  .ms__ctas { display: flex; gap: calc(var(--u) * 1.2); margin-top: calc(var(--u) * .6); }
  .ms__btn { padding: calc(var(--u) * 1.1) calc(var(--u) * 2.1); border-radius: 99px; background: var(--m-accent); color: var(--m-accent-ink); font-size: calc(var(--u) * 1.3); font-weight: 600; white-space: nowrap; }
  .ms__btn--ghost { background: transparent; color: var(--m-ink); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--m-ink) 25%, transparent); }

  .ms__photo { position: relative; aspect-ratio: 1 / 1.02; border-radius: calc(var(--u) * 1.6); overflow: hidden; background: linear-gradient(150deg, var(--m-photo-a), var(--m-photo-b)); }
  .ms__badge { position: absolute; left: calc(var(--u) * 1.6); bottom: calc(var(--u) * 1.6); padding: calc(var(--u) * .9) calc(var(--u) * 1.4); border-radius: calc(var(--u) * 1); background: var(--m-surface); color: var(--m-ink); font-size: calc(var(--u) * 1.1); display: flex; gap: calc(var(--u) * .7); box-shadow: 0 calc(var(--u) * .8) calc(var(--u) * 2.4) rgba(0,0,0,.18); white-space: nowrap; }
  .ms__badge b { color: var(--m-accent); }

  .ms__cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: calc(var(--u) * 1.8); padding: 0 calc(var(--u) * 4) calc(var(--u) * 3.5); }
  .ms__card { display: flex; flex-direction: column; gap: calc(var(--u) * .8); padding: calc(var(--u) * 1.4); border-radius: calc(var(--u) * 1.2); background: var(--m-surface); font-size: calc(var(--u) * 1.4); }
  .ms__thumb { height: calc(var(--u) * 6); border-radius: calc(var(--u) * .8); background: linear-gradient(calc(120deg + var(--k) * 40deg), color-mix(in srgb, var(--m-photo-a) 80%, white), var(--m-photo-b)); opacity: .85; }
  .ms__line { height: calc(var(--u) * .6); border-radius: 99px; background: color-mix(in srgb, var(--m-ink) 12%, transparent); }
  .ms__line--short { width: 60%; }

  /* ---------- Mobile layout ---------- */
  .ms--mobile { --u: 2.15cqw; }
  .ms--mobile .ms__nav { padding: calc(var(--u) * 5.5) calc(var(--u) * 4) calc(var(--u) * 2.5); justify-content: space-between; }
  .ms--mobile .ms__brand { font-size: calc(var(--u) * 2.4); }
  .ms--mobile .ms__brand i { width: calc(var(--u) * 2.4); height: calc(var(--u) * 2.4); }
  .ms__burger { display: grid; gap: calc(var(--u) * .7); }
  .ms__burger i { display: block; width: calc(var(--u) * 3); height: calc(var(--u) * .35); background: var(--m-ink); border-radius: 2px; }
  .ms--mobile .ms__hero { grid-template-columns: 1fr; padding: calc(var(--u) * 2) calc(var(--u) * 4); gap: calc(var(--u) * 3); flex: none; }
  .ms--mobile .ms__kicker { font-size: calc(var(--u) * 1.5); }
  .ms--mobile .ms__title { font-size: calc(var(--u) * 4.6); }
  .ms--mobile .ms__text { font-size: calc(var(--u) * 1.75); }
  .ms--mobile .ms__btn { font-size: calc(var(--u) * 1.6); padding: calc(var(--u) * 1.4) calc(var(--u) * 2.4); }
  .ms--mobile .ms__photo { aspect-ratio: 1.25; order: -1; }
  .ms--mobile .ms__badge { font-size: calc(var(--u) * 1.4); }
  .ms--mobile .ms__cards { grid-template-columns: 1fr 1fr; padding: calc(var(--u) * 1) calc(var(--u) * 4); gap: calc(var(--u) * 2); }
  .ms--mobile .ms__card { font-size: calc(var(--u) * 1.6); padding: calc(var(--u) * 1.6); }
  .ms--mobile .ms__card:nth-child(3) { display: none; }
  .ms--mobile .ms__thumb { height: calc(var(--u) * 7); }
  .ms__call { position: absolute; left: calc(var(--u) * 4); right: calc(var(--u) * 4); bottom: calc(var(--u) * 4); padding: calc(var(--u) * 2) 0; text-align: center; border-radius: 99px; background: var(--m-accent); color: var(--m-accent-ink); font-weight: 700; font-size: calc(var(--u) * 1.9); box-shadow: 0 calc(var(--u) * 1) calc(var(--u) * 3) rgba(0,0,0,.25); }
</style>
