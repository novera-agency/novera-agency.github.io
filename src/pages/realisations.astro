---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Projects from '../components/sections/Projects.astro';
import CallToAction from '../components/sections/CallToAction.astro';
---
<BaseLayout title="Réalisations — sites pour chaque métier" description="Découvrez nos réalisations et projets de démonstration : boulangerie, restaurant, kebab, épicerie, paysagiste, boucherie et plus encore.">
  <PageHero
    eyebrow="Réalisations"
    title="Des sites conçus *pour chaque métier.*"
    intro="Chaque secteur a ses codes, ses clients et ses attentes. Choisissez un projet pour voir comment nous adaptons la structure, le ton et le design à chaque activité."
  />
  <Projects showHeading={false} />
  <CallToAction />
</BaseLayout>
